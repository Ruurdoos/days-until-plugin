{
  "id": "days-until",
  "name": "Days Until",
  "version": "1.1.0",
  "description": "Standalone countdown board for Super Productivity.",
  "manifestVersion": 1,
  "minSupVersion": "14.0.0",
  "icon": "icon.svg",
  "iFrame": true,
  "sidePanel": true,
  "hooks": ["persistedDataChanged"],
  "permissions": [
    "registerMenuEntry",
    "showIndexHtmlAsView",
    "persistDataSynced",
    "loadSyncedData",
    "registerHook"
  ]
}
